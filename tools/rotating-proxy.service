[Unit]
# 多 IP 轮换代理，给 iphone-hunter 的主程序（scout）刷库存用。
# 装法（Ubuntu 22.04）：
#   sudo cp tools/rotating-proxy.py /opt/rotating-proxy/rotating-proxy.py
#   sudo cp tools/ips.txt.example    /opt/rotating-proxy/ips.txt   # 改成你的真实 IP
#   sudo cp tools/rotating-proxy.service /etc/systemd/system/
#   # 把下面的 ROTPROXY_PASS 改成强密码，或写进 /opt/rotating-proxy/proxy.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rotating-proxy
#   sudo systemctl status rotating-proxy
#   journalctl -u rotating-proxy -f          # 看日志
Description=iphone-hunter 多 IP 轮换出站代理
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 密码放这个文件（chmod 600），别写进 service：ROTPROXY_PASS=...
EnvironmentFile=/opt/rotating-proxy/proxy.env
WorkingDirectory=/opt/rotating-proxy
# 结账也走它的话：每个账号一份 IP 文件（一行一个），在后面加
#   --buyer 8081=/opt/rotating-proxy/buyer-a.txt --buyer 8082=/opt/rotating-proxy/buyer-b.txt --allow 买手机器公网IP
# 见 tools/README.md
# 或者直接用启动脚本（自动挂 buyer-*.txt、读同目录 proxy.env）：
#   ExecStart=/opt/rotating-proxy/run-proxy.sh
ExecStart=/usr/bin/python3 -u /opt/rotating-proxy/rotating-proxy.py --port 8080 --user hunter --ips /opt/rotating-proxy/ips.txt
Restart=always
RestartSec=3

# 绑本机任意源 IP 需要的能力（source_address 绑非本地 IP 时才用得上；
# IP 是真挂在网卡上的话可以不要，留着更省心）
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
# 收紧权限
DynamicUser=false
User=rotproxy
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/rotating-proxy
PrivateTmp=true

[Install]
WantedBy=multi-user.target
